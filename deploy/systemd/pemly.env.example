# Pemly Environment Configuration
# Copy this file to /opt/pemly/.env and configure

# =============================================================================
# REQUIRED SETTINGS
# =============================================================================

# Django secret key - generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Encryption key for private keys at rest - generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Database URL - PostgreSQL recommended for production
# Format: postgres://user:password@host:port/database
DATABASE_URL=postgres://pemly:password@localhost:5432/pemly

# Allowed hosts - comma-separated list of hostnames
DJANGO_ALLOWED_HOSTS=pemly.example.com,localhost

# CSRF trusted origins - comma-separated, include protocol
CSRF_TRUSTED_ORIGINS=https://pemly.example.com

# =============================================================================
# CFSSL SETTINGS
# =============================================================================

# Auto-start CFSSL server (recommended: true)
CFSSL_AUTO_START=true

# Path to cfssl binary (leave empty to auto-detect from PATH)
CFSSL_BINARY_PATH=

# CFSSL server binding
CFSSL_HOST=127.0.0.1
CFSSL_PORT=8888

# =============================================================================
# OPTIONAL SETTINGS
# =============================================================================

# Certificate storage path (default: /opt/pemly/storage/certificates)
# CERTIFICATE_STORAGE_PATH=/opt/pemly/storage/certificates

# Django log level (default: INFO)
# DJANGO_LOG_LEVEL=INFO
