# =============================================================================
# Pemly PKI Manager - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values before running.

# =============================================================================
# REQUIRED - Must be set before first run
# =============================================================================

# Django secret key
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secret-key-here

# Encryption key for private keys at rest (Fernet)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: If you lose this key, all encrypted private keys become unrecoverable!
ENCRYPTION_KEY=

# PostgreSQL password (for Docker deployment)
POSTGRES_PASSWORD=change-me-use-a-strong-password

# =============================================================================
# DJANGO SETTINGS
# =============================================================================

DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CSRF trusted origins (required for HTTPS, include https:// prefix)
# CSRF_TRUSTED_ORIGINS=https://pemly.example.com

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
DJANGO_LOG_LEVEL=INFO

# HTTPS / secure-cookie hardening (production only). Secure by default; set to
# false only for internal HTTP-only deployments behind a trusted TLS proxy.
# SECURE_SSL_REDIRECT=true
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true
# SECURE_HSTS_SECONDS=31536000
# Set to true only when TLS is terminated by a trusted proxy that sets
# X-Forwarded-Proto (prevents an HTTPS redirect loop):
# USE_X_FORWARDED_PROTO=false

# Trust the X-Forwarded-For header for audit-log client IPs. Enable ONLY when
# running behind a trusted proxy; otherwise clients can spoof their recorded IP.
# The compose stack sets this to true, because Traefik is the only ingress and
# REMOTE_ADDR would otherwise record the proxy's container address for every
# action. Only the header's last hop - the one the proxy itself wrote - is read.
# TRUST_X_FORWARDED_FOR=false

# Login throttling. Attempts are refused once this many failures accumulate in
# the window for a username-and-address pair (so an attacker locks out only
# their own address, never the operator) and, far more loosely, per address
# across all usernames (spraying). Failures are counted from the audit log, so an
# auditor sees every rejected attempt and the limit holds across workers. It
# applies to every login path, the Django admin included. 0 disables a limit.
# LOGIN_FAILURE_LIMIT=10
# LOGIN_FAILURE_LIMIT_PER_IP=50
# LOGIN_FAILURE_WINDOW_MINUTES=15

# =============================================================================
# DATABASE SETTINGS
# =============================================================================

# Option 1: Use Docker PostgreSQL (default)
# Just set POSTGRES_PASSWORD above, DATABASE_URL is auto-configured
# Run: docker compose up -d

# Option 2: Use external PostgreSQL
# Set DATABASE_URL and run: docker compose up -d app
# DATABASE_URL=postgres://user:password@hostname:5432/dbname

# Option 3: Customize Docker PostgreSQL
# POSTGRES_USER=pemly
# POSTGRES_DB=pemly

# =============================================================================
# CFSSL SETTINGS (usually no changes needed)
# =============================================================================

# CFSSL runs inside the container and auto-starts with Django.
# These settings are only needed for advanced configurations.

# CFSSL_AUTO_START=true        # Auto-start CFSSL with Django (default: true)
# CFSSL_HOST=127.0.0.1         # Host for CFSSL to bind to
# CFSSL_PORT=8888              # Port for CFSSL to listen on

# =============================================================================
# STORAGE
# =============================================================================

# Certificate storage path (mounted as volume in Docker)
# CERTIFICATE_STORAGE_PATH=/path/to/storage/certificates
